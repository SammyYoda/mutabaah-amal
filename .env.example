# Copy to .env and adjust. Load with:  set -a; . ./.env; set +a; npm start
# (or point a systemd unit at it with EnvironmentFile=).

# SQLite file; migrations run on start.
DATABASE_URL=file:./data/mutabaah.db

# HTTP port and bind address. Use HOST=127.0.0.1 when behind a reverse proxy.
PORT=3101
HOST=127.0.0.1

# Exact public origin of the app. Required in production: logins and other
# mutating requests are rejected with 403 unless the browser Origin matches.
APP_ORIGIN=https://mutabaah.example.org

# "production" serves dist/web and marks the session cookie Secure.
NODE_ENV=production

# Only behind a reverse proxy: a hop count (1) or a list of proxy IPs/CIDRs.
# Leave unset/0 when clients connect directly.
TRUST_PROXY=127.0.0.1

# Branding (optional). Defaults: APP_NAME="Mutaba'ah Amal", ORG_NAME unset.
APP_NAME=Mutaba'ah Amal
ORG_NAME=Example Organisation

# Optional JSON file with the default amalan copied into each new usrah.
# Unset = small neutral starter set. See examples/amalan-ikram.json.
# AMALAN_FILE=examples/amalan-ikram.json
